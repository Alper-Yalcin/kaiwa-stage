# --- Veri ve modeller (büyük, repoya konmaz) ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

models/pretrained/*
models/finetuned/*
!models/**/.gitkeep

# Üretilen sesler / loglar
outputs/wav/*
outputs/mp3/*
outputs/logs/*
!outputs/**/.gitkeep

# Klonlanan üçüncü parti repolar (örn. Style-Bert-VITS2)
third_party/*
!third_party/.gitkeep

# İndirilen zip'ler
*.zip
*.tar
*.tar.gz

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# --- Ortam / sırlar ---
.env

# --- IDE / OS ---
.vscode/
.idea/
Thumbs.db
.DS_Store

# Eğitilen model ağırlıkları paylaşılmaz (bkz. README > Lisans)
releases/*/model_*/
# JVS transkriptli manifestler; scripts/build_manifest.py yeniden üretir
metadata/*.csv
