# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# .env git'e KONULMAZ (.gitignore'da).

# JVS Google Drive dosya ID'si (resmi sayfadaki indirme linki)
JVS_GDRIVE_FILE_ID=19oAw8wWn3Y7z6CKChRdAyGOB9yupL_Xt

# Klonlanmış Style-Bert-VITS2 reposunun yolu
